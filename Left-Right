import sys

# Augmenter la limite de récursion pour les grands graphes
sys.setrecursionlimit(10000)

class PlanarityChecker:
    def __init__(self, num_vertices):
        self.V = num_vertices
        self.adj = [[] for _ in range(num_vertices)]
        self.depth = [-1] * num_vertices
        self.parent = [-1] * num_vertices
        self.back_edges = []  # Stocke les arêtes arrière sous forme (descendant, ancêtre)

    def add_edge(self, u, v):
        self.adj[u].append(v)
        self.adj[v].append(u)

    # ---------------------------------------------------------
    # PHASE 1 : DFS pour construire l'arbre et trouver les arêtes arrière
    # ---------------------------------------------------------
    def dfs(self, u, p, d):
        self.depth[u] = d
        self.parent[u] = p
        for v in self.adj[u]:
            if v == p:
                continue
            if self.depth[v] == -1:  # Non visité -> arête d'arbre
                self.dfs(v, u, d + 1)
            elif self.depth[v] < self.depth[u]:  # Déjà visité et ancêtre -> arête arrière
                # On l'enregistre une seule fois (du descendant vers l'ancêtre)
                self.back_edges.append((u, v))

    # ---------------------------------------------------------
    # PHASE 2 : Test de planarité avec la pile (feuille -> racine)
    # ---------------------------------------------------------
    def is_planar(self):
        # 1. Lancer le DFS depuis le sommet 0 (on suppose le graphe connexe)
        # Pour gérer les graphes non connexes, on pourrait boucler sur tous les sommets
        if self.V > 0 and self.depth[0] == -1:
            self.dfs(0, -1, 0)

        # 2. Trier les sommets par profondeur décroissante (feuilles d'abord)
        vertices_by_depth = sorted(range(self.V), key=lambda x: self.depth[x], reverse=True)

        # 3. Initialiser la pile et le dictionnaire de contraintes
        stack = []
        constraints = {}

        # 4. Parcourir les sommets de la feuille vers la racine
        for v in vertices_by_depth:
            # Trouver les arêtes arrière qui partent de ce sommet v
            edges_from_v = [e for e in self.back_edges if e[0] == v]
            
            # Trier ces arêtes par profondeur de leur ancêtre (de la plus proche à la plus lointaine)
            edges_from_v.sort(key=lambda e: self.depth[e[1]])

            for edge in edges_from_v:
                # --- TEST DE CONFLIT AVANT D'EMPILER ---
                for active_edge in stack:
                    d1, a1 = edge
                    d2, a2 = active_edge
                    
                    dep_d1, dep_a1 = self.depth[d1], self.depth[a1]
                    dep_d2, dep_a2 = self.depth[d2], self.depth[a2]
                    
                    # Condition d'imbrication : a < c < b < d ou c < a < d < b
                    is_nested = False
                    if dep_a1 < dep_a2 < dep_d1 < dep_d2:
                        is_nested = True
                    elif dep_a2 < dep_a1 < dep_d2 < dep_d1:
                        is_nested = True
                    
                    if is_nested:
                        if edge in constraints and active_edge in constraints:
                            if constraints[edge] == constraints[active_edge]:
                                return False  # CONFLIT
                        elif edge in constraints:
                            constraints[active_edge] = 1 - constraints[edge]
                        elif active_edge in constraints:
                            constraints[edge] = 1 - constraints[active_edge]
                        else:
                            constraints[edge] = 0
                            constraints[active_edge] = 1
                
                # --- EMPILER LA NOUVELLE ARÊTE ---
                stack.append(edge)

            # --- DÉPILER LES ARÊTES TERMINÉES ---
            while stack:
                top_edge = stack[-1]
                # Si l'ancêtre de l'arête au sommet de la pile est à une profondeur >= celle de v
                if self.depth[top_edge[1]] >= self.depth[v]:
                    stack.pop()
                else:
                    break

        return True

# ---------------------------------------------------------
# FONCTION POUR LIRE LE FICHIER GRAPH.TXT
# ---------------------------------------------------------
def read_graphs_from_file(filename):
    graphs = []
    current_graph = None
    
    try:
        with open(filename, 'r') as f:
            lines = f.readlines()
            
        i = 0
        while i < len(lines):
            line = lines[i].strip()
            
            # Ignorer les commentaires et les lignes vides
            if not line or line.startswith('#'):
                i += 1
                continue
            
            # Lire le nombre de sommets et d'arêtes
            parts = line.split()
            if len(parts) == 2:
                V, E = int(parts[0]), int(parts[1])
                current_graph = PlanarityChecker(V)
                i += 1
                
                # Lire les E arêtes
                edges_read = 0
                while edges_read < E and i < len(lines):
                    edge_line = lines[i].strip()
                    if not edge_line or edge_line.startswith('#'):
                        i += 1
                        continue
                    
                    u, v = map(int, edge_line.split())
                    current_graph.add_edge(u, v)
                    edges_read += 1
                    i += 1
                
                graphs.append(current_graph)
            else:
                i += 1
                
    except FileNotFoundError:
        print(f"Erreur : Le fichier '{filename}' n'a pas été trouvé.")
        sys.exit(1)
        
    return graphs

# ---------------------------------------------------------
# MAIN : LECTURE DU FICHIER ET EXÉCUTION DES TESTS
# ---------------------------------------------------------
if __name__ == "__main__":
    filename = "graph.txt"
    graphs = read_graphs_from_file(filename)
    
    print(f"--- Analyse de {len(graphs)} graphe(s) depuis '{filename}' ---\n")
    
    for idx, graph in enumerate(graphs, start=1):
        result = graph.is_planar()
        status = "PLANAIRE" if result else "NON PLANAIRE"
        print(f"Graphe {idx} (V={graph.V}) : {status}")
        
    print("\n--- Fin des tests ---")
